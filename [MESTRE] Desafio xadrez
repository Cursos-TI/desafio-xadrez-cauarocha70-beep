#include <stdio.h>

/*
 * Desafio Mestre - Movimentação de peças de xadrez
 * Torre, Bispo e Rainha: recursividade
 * Cavalo: loops aninhados com múltiplas variáveis, continue e break
 * Bispo: recursividade + loops aninhados
 */


// TORRE - move para a direita. Cada chamada resolve uma casa.
void moverTorre(int casas) {
    if (casas <= 0) return;    // caso-base: encerra a recursão

    printf("Direita\n");
    moverTorre(casas - 1);     // chamada recursiva com o problema menor
}


// RAINHA - mesma lógica da Torre, mas para a esquerda.
void moverRainha(int casas) {
    if (casas <= 0) return;    // caso-base

    printf("Esquerda\n");
    moverRainha(casas - 1);    // chamada recursiva
}


// BISPO - diagonal: cada casa vale um "Cima" + um "Direita".
// Une recursividade com loops aninhados.
void moverBispo(int casas) {
    if (casas <= 0) return;    // caso-base

    for (int vertical = 1; vertical <= 1; vertical++) {          // loop externo: vertical
        printf("Cima\n");
        for (int horizontal = 1; horizontal <= 1; horizontal++) { // loop interno: horizontal
            printf("Direita\n");
        }
    }

    moverBispo(casas - 1);     // chamada recursiva para o resto da diagonal
}


int main() {
    // Valores definidos direto no código, como pede o enunciado
    int casasTorre  = 5;
    int casasBispo  = 5;
    int casasRainha = 8;

    int movimentosCavalo = 1;   // quantidade de movimentos em L
    int passosCavalo     = 3;   // passos de um L: 2 para cima + 1 para o lado
    int casasCimaCavalo  = 2;   // casas para cima em cada L

    printf("Movimento da Torre:\n");
    moverTorre(casasTorre);
    printf("\n");

    printf("Movimento do Bispo:\n");
    moverBispo(casasBispo);
    printf("\n");

    printf("Movimento da Rainha:\n");
    moverRainha(casasRainha);
    printf("\n");

    // CAVALO - movimento em "L": duas casas para cima e uma para a direita
    printf("Movimento do Cavalo:\n");

    for (int movimento = 1, contador = 0; movimento <= movimentosCavalo; movimento++) {
        for (int passo = 1; passo <= passosCavalo; passo++) {

            // Ainda faltam casas para cima: imprime e pula para o próximo passo
            if (contador < casasCimaCavalo) {
                printf("Cima\n");
                contador++;
                continue;
            }

            printf("Direita\n");
            break;    // o L terminou, encerra o loop interno
        }
    }
    printf("\n");

    return 0;
}